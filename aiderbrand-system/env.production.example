# ── Traefik ───────────────────────────────────────────────────────────────────
ACME_EMAIL=tu@email.com

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=aiderbrand
POSTGRES_USER=appuser
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD

# ── API ───────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
DATABASE_URL=postgresql://appuser:CHANGE_ME_DB_PASSWORD@postgres:5432/aiderbrand
FRONTEND_URL=https://clientes.aiderbrand.com

# JWT — generate with: openssl rand -hex 64
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Invitations / Password reset
INVITATION_EXPIRES_IN_HOURS=72
PASSWORD_RESET_EXPIRES_IN_HOURS=1

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
MAIL_ENABLED=false
MAIL_FROM_EMAIL=no-reply@aiderbrand.com
MAIL_FROM_NAME=Aiderbrand
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
