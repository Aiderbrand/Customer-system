# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/aiderbrand?schema=public"

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET="change-me-access-secret-at-least-32-chars"
JWT_REFRESH_SECRET="change-me-refresh-secret-at-least-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── App ──────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV="development"
FRONTEND_URL="http://localhost:3000"

# ─── Mail / SMTP ──────────────────────────────────────────────────────────────
MAIL_ENABLED=false
MAIL_FROM_EMAIL="no-reply@example.com"
MAIL_FROM_NAME="Aiderbrand"
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE=false

# ─── Invitations ──────────────────────────────────────────────────────────────
INVITATION_EXPIRES_IN_HOURS=72

# ─── Password Reset ───────────────────────────────────────────────────────────
PASSWORD_RESET_EXPIRES_IN_HOURS=1
