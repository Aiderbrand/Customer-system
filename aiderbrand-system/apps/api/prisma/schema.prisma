// ─── Prisma Schema: Aiderbrand Auth + Multi-Tenant Foundation ────────────────
// Design: auth-company-invitations
// Roles live in CompanyMembership, NOT on User (no self-registration)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  SYSTEM_ADMIN
  PROJECT_LEAD
  DELIVERY_SPECIALIST
  ACCOUNT_OWNER
  COLLABORATOR
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum ProjectStatus {
  planificacion
  desarrollo
  pruebas
  revision_cliente
  produccion
  pausado
  finalizado
}

enum PhaseStatus {
  planificacion
  desarrollo
  pruebas
  revision
  produccion
  completada
}

enum TaskStatus {
  pendiente
  en_progreso
  bloqueada
  completada
}

enum Priority {
  baja
  media
  alta
  urgente
}

enum TicketStatus {
  pendiente
  en_revision
  en_proceso
  cerrado
}

enum CommentType {
  public
  internal
}

// ─── User ─────────────────────────────────────────────────────────────────────
// No role, no companyId — roles live in CompanyMembership
// Email is globally unique (user can belong to multiple companies)

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  avatarUrl    String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime? // soft delete

  // Relations
  memberships       CompanyMembership[]
  invitationsCreated Invitation[]        @relation("InvitationCreatedBy")
  refreshTokens     RefreshToken[]
  passwordResets    PasswordResetToken[]
  auditLogs         AuditLog[]          @relation("AuditLogActor")
  roleSimulationSessionsStarted RoleSimulationSession[] @relation("RoleSimulationSessionActor")
  roleSimulationSessionsStopped RoleSimulationSession[] @relation("RoleSimulationSessionStoppedBy")

  @@map("users")
}

// ─── Company ──────────────────────────────────────────────────────────────────

model Company {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // soft delete

  // Relations
  memberships CompanyMembership[]
  invitations Invitation[]
  auditLogs   AuditLog[]
  projects    Project[]
  tickets     Ticket[]

  @@map("companies")
}

// ─── CompanyMembership ────────────────────────────────────────────────────────
// A user can belong to many companies with different roles
// Role lives here, NOT on User

model CompanyMembership {
  id        String   @id @default(uuid())
  userId    String
  companyId String
  role      Role
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user    User    @relation(fields: [userId], references: [id])
  company Company @relation(fields: [companyId], references: [id])

  @@unique([userId, companyId])
  @@map("company_memberships")
}

// ─── Invitation ───────────────────────────────────────────────────────────────
// Opaque token hashed via SHA-256 before storage
// Partial unique: only one PENDING invite per email+company

model Invitation {
  id          String           @id @default(uuid())
  companyId   String
  email       String
  role        Role
  tokenHash   String           @unique
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime
  createdById String?
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  // Relations
  company   Company @relation(fields: [companyId], references: [id])
  createdBy User?   @relation("InvitationCreatedBy", fields: [createdById], references: [id])

  // Partial unique index: no duplicate pending invites for same email+company
  // Enforced via DB-level unique index with WHERE status = 'PENDING'
  @@index([email, companyId, status])
  @@map("invitations")
}

// ─── PasswordResetToken ───────────────────────────────────────────────────────
// Opaque token, SHA-256 hashed in DB. Expires 1h. One-time use.

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@map("password_reset_tokens")
}

// ─── RefreshToken ─────────────────────────────────────────────────────────────
// Stored hashed. Server-side revocable (needed for password reset flow).

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@map("refresh_tokens")
}

model RoleSimulationSession {
  id              String   @id @default(uuid())
  actorUserId     String   @map("actor_user_id")
  effectiveRole   Role     @map("effective_role")
  startedAt       DateTime @default(now()) @map("started_at")
  endedAt         DateTime? @map("ended_at")
  stoppedAt       DateTime? @map("stopped_at")
  stoppedByUserId String?  @map("stopped_by_user_id")

  actorUser     User    @relation("RoleSimulationSessionActor", fields: [actorUserId], references: [id])
  stoppedByUser User?   @relation("RoleSimulationSessionStoppedBy", fields: [stoppedByUserId], references: [id])

  @@index([actorUserId, endedAt])
  @@index([effectiveRole, endedAt])
  @@map("role_simulation_sessions")
}

// ─── Project ──────────────────────────────────────────────────────────────────

model Project {
  id                String        @id @default(uuid())
  companyId         String
  name              String
  description       String        @default("")
  status            ProjectStatus @default(planificacion)
  projectLeadId     String?
  deliveryOwnerId   String?
  targetLaunchAt    DateTime?
  isDependencyReady Boolean       @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?

  company  Company       @relation(fields: [companyId], references: [id])
  phases   Phase[]
  tasks    Task[]
  tickets  Ticket[]
  notes    ProjectNote[]

  @@index([companyId])
  @@map("projects")
}

// ─── Phase ────────────────────────────────────────────────────────────────────

model Phase {
  id              String      @id @default(uuid())
  projectId       String
  companyId       String
  name            String
  order           Int
  status          PhaseStatus @default(planificacion)
  startsAt        DateTime?
  dueAt           DateTime?
  completedAt     DateTime?
  ownerUserId     String?
  milestone       String?
  blocker         String?
  isClientVisible Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?

  project Project @relation(fields: [projectId], references: [id])
  tasks   Task[]

  @@index([projectId])
  @@map("phases")
}

// ─── Task ─────────────────────────────────────────────────────────────────────

model Task {
  id               String     @id @default(uuid())
  projectId        String
  companyId        String
  phaseId          String?
  title            String
  status           TaskStatus @default(pendiente)
  completionType   String?
  priority         Priority   @default(media)
  assigneeUserId   String?
  dueAt            DateTime?
  dependencyTaskId String?
  blockReason      String?
  resolutionNote   String?
  visibleToClient  Boolean    @default(false)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  deletedAt        DateTime?

  project    Project             @relation(fields: [projectId], references: [id])
  phase      Phase?              @relation(fields: [phaseId], references: [id])
  dependency Task?               @relation("TaskDependency", fields: [dependencyTaskId], references: [id])
  dependents Task[]              @relation("TaskDependency")
  checklist  TaskChecklistItem[]

  @@index([projectId])
  @@index([phaseId])
  @@map("tasks")
}

model TaskChecklistItem {
  id     String  @id @default(uuid())
  taskId String
  label  String
  done   Boolean @default(false)

  task Task @relation(fields: [taskId], references: [id])

  @@map("task_checklist_items")
}

// ─── ProjectNote ──────────────────────────────────────────────────────────────

model ProjectNote {
  id        String    @id @default(uuid())
  projectId String
  phaseId   String?
  authorId  String
  body      String
  parentId  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  project Project       @relation(fields: [projectId], references: [id])
  parent  ProjectNote?  @relation("NoteThread", fields: [parentId], references: [id])
  replies ProjectNote[] @relation("NoteThread")

  @@index([projectId])
  @@map("project_notes")
}

// ─── Ticket ───────────────────────────────────────────────────────────────────

model Ticket {
  id           String       @id @default(uuid())
  companyId    String
  projectId    String?
  title        String
  description  String       @default("")
  status       TicketStatus @default(pendiente)
  priority     Priority     @default(media)
  createdById  String?
  assignedToId String?
  slaDeadline  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?

  company  Company         @relation(fields: [companyId], references: [id])
  project  Project?        @relation(fields: [projectId], references: [id])
  comments TicketComment[]

  @@index([companyId])
  @@index([projectId])
  @@map("tickets")
}

model TicketComment {
  id        String      @id @default(uuid())
  ticketId  String
  userId    String
  content   String
  type      CommentType @default(public)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  deletedAt DateTime?

  ticket Ticket @relation(fields: [ticketId], references: [id])

  @@index([ticketId])
  @@map("ticket_comments")
}

// ─── AuditLog ─────────────────────────────────────────────────────────────────
// Immutable audit record for every relevant action

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?  // null = system action
  companyId  String?  // null = cross-company action (e.g. SYSTEM_ADMIN forgot-password)
  action     String   // e.g. "auth.login", "invitation.created", "password.reset"
  entityType String?  // e.g. "User", "Invitation"
  entityId   String?  // e.g. UUID of the affected entity
  metadata   Json?    // arbitrary JSONB context
  createdAt  DateTime @default(now())

  // Relations (nullable — actor may be deleted)
  actor   User?    @relation("AuditLogActor", fields: [actorId], references: [id])
  company Company? @relation(fields: [companyId], references: [id])

  @@index([actorId])
  @@index([companyId])
  @@index([action])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
